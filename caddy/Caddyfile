# pinn. – Caddy (HTTPS via DuckDNS, certificate via DNS challenge, no port forwarding needed)
# Belongs in <project>/caddy/Caddyfile. Subdomain and token come from the set-up in pinn.
# (konfig/pinn.env) or the defaults in docker-compose.yaml – nothing has to be entered here.
# Caddy only starts once DuckDNS is set up, and restarts itself after changes.
{
	# Port 80 is not opened to the outside – no redirect from http to https needed
	auto_https disable_redirects
}

{$DUCKDNS_SUBDOMAIN}.duckdns.org {
	tls {
		dns duckdns {$DUCKDNS_TOKEN}
		# Checks the DNS records via public servers – so the router (DNS rebind protection) does not interfere
		resolvers 1.1.1.1 9.9.9.9
	}
	encode zstd gzip
	reverse_proxy pocketbase:80
}
